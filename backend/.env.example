PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusconnect?retryWrites=true&w=majority
JWT_SECRET=campusconnect_jwt_secret_production_key_super_secure_9922
JWT_REFRESH_SECRET=campusconnect_jwt_refresh_secret_production_key_8833
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
FASTAPI_SERVICE_URL=http://localhost:8000/api/v1
UPLOAD_DIR=uploads/resumes
# Frontend Vercel URL (add your vercel domain here; *.vercel.app is also automatically permitted by backend CORS)
CLIENT_ORIGIN=https://your-frontend-project.vercel.app

